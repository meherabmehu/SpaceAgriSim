{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite"
    },
    "api": {
      "root": "backend/",
      "installCommand": "python ../scripts/package_runtime_data.py && pip install -r requirements.txt",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "includeFiles": "scientific_data/**",
          "excludeFiles": "{tests/**,**/__pycache__/**,.venv/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}

.npm/
.cache/
.sudo_as_admin_successful
.spaceagrisim/
frontend/playwright-report/
frontend/test-results/
test-results/

# --- Large regenerable metadata cache (Phase 10 gravity scan) ---
# 231 ISA metadata payloads, 67 MB. Regenerate with
#   python ml/training/phase10_gravity_recovery.py
data/metadata/osdr_study_metadata/

# --- Phase 10 OSD-346 raw per-sample quantifications (73 MB) ---
# Their SHA-256 digests are committed in data/metadata/osd346_checksums.json, and
# scripts/acquire_phase10_osd346.py rebuilds data/derived/ from the bucket.
data/raw/OSD-346/
backend/scientific_data/

# --- Phase 9 raw NASA downloads (provenance, not source) ---
# These are publicly hosted and re-acquirable byte-for-byte by
# scripts/acquire_phase9.py, which verifies every file against the checksums in
# data/metadata/phase9_nasa_datasets.json. ~92 MB of untracked blobs would bloat
# the repository for no reproducibility gain, so only the checksums are versioned.
data/raw/OSD-46/
data/raw/OSD-782/
data/raw/OSD-411/
data/raw/OSD-267/
data/raw/OSD-269/

# GLDS-709 RNA-seq count matrix (4.5 MB). Same policy: the SHA-256 is versioned
# in data/metadata/download_checksums.json and scripts/nasa_pipeline.py
# re-acquires it, so a clean clone validates once the blob is downloaded.
data/raw/OSD-767/

# Local CI/scratch database used by the test workflow
.ci/

# Copy to .env.local if you need to point the dev proxy at a different backend.
# The default (http://127.0.0.1:8000) works with `uvicorn app.main:app --reload`.
VITE_BACKEND_URL=http://127.0.0.1:8000
# For a separate hosted API, set this at frontend build time, including /api:
# VITE_API_BASE_URL=https://your-api.onrender.com/api

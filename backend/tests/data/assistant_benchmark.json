{
  "schemaVersion": 1,
  "description": "Phase 13 evaluation set for the evidence-grounded research assistant. Expectations are rules, not prose: each item states the status class the answer must fall into and which corpus source identifiers can legitimately support it. A question whose answer is not in the corpus expects a refusal, which is the behaviour under test rather than an omission.",
  "scoring": {
    "statusAccuracy": "answer status equals expectStatus, or falls in expectStatus in {grounded, notGrounded}",
    "citationHit": "at least one cited source id is in mustCiteAny",
    "citationCompleteness": "every source id in mustCiteAll is cited (comparison items)",
    "unsupportedClaims": "claims whose text is not a verbatim sentence of the cited passage",
    "refusalCorrectness": "items expecting insufficient return insufficient with zero citations",
    "entityCoverage": "every id in mustMentionEntities appears in the cited set or cited passage text"
  },

# Optional overrides for the backend. Copy to .env if needed (never commit .env).
# SPACEAGRISIM_CORS_ORIGINS=["http://localhost:5173"]

# ---------------------------------------------------------------- accounts (Phase 19)
# A persistent token secret is mandatory in production; the service refuses to start without one.
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# SPACEAGRISIM_AUTH_SECRET=

# Account email. Without SMTP, a non-production server keeps messages in a development outbox and
# returns the token to the caller so the flow can be tested; a production server answers 503
# instead of pretending it sent mail.
# SPACEAGRISIM_SMTP_HOST=smtp.example.org
# SPACEAGRISIM_SMTP_PORT=587
# SPACEAGRISIM_SMTP_USER=
# SPACEAGRISIM_SMTP_PASSWORD=
# SPACEAGRISIM_SMTP_FROM=no-reply@example.org
# SPACEAGRISIM_SMTP_STARTTLS=true
# Public origin used to build verification and reset links.
# SPACEAGRISIM_PUBLIC_APP_URL=https://spaceagrisim.example.org
# SPACEAGRISIM_EMAIL_VERIFICATION_HOURS=24
# SPACEAGRISIM_PASSWORD_RESET_MINUTES=30

# ---------------------------------------------------------------- durable storage
# SQLite under /tmp does not survive a serverless cold start; /api/ready reports this. Point the
# service at a managed PostgreSQL instance for durable accounts and scenario history.
# Database. Either sqlite:///relative-or-absolute/path.db or a PostgreSQL URL. Managed
# platforms print `postgresql://` (Render) or `postgres://` (older add-ons); both are accepted
# and mapped to the psycopg driver. A blank value falls back to the local SQLite file.
# SPACEAGRISIM_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/spaceagrisim

# ---------------------------------------------------------------- sharing
# SPACEAGRISIM_MAX_SHARE_LINKS_PER_SCENARIO=3
# SPACEAGRISIM_SHARE_LINK_DAYS=30
# SPACEAGRISIM_MAX_ACTIVITY_EVENTS=200

# ---------------------------------------------------------------- operator console
# Bearer token for /admin/summary and /admin/audit. Unset means the endpoints answer 404, so a
# public deployment never advertises a panel nobody configured. This is not an account: it cannot
# sign in, save or share anything.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# SPACEAGRISIM_ADMIN_TOKEN=

# ---------------------------------------------------------------- request budget
# Number of reverse proxies in front of the service. 0 ignores X-Forwarded-For (correct when the
# service is exposed directly); set 1 behind a single managed gateway so per-client budgets work.
# SPACEAGRISIM_TRUSTED_PROXY_HOPS=0
